# PAGOBLI_TEMPLATE_HOST_DIR=/ruta/a/tu/base-laravel
# PAGOBLI_WORKSPACE_HOST_DIR=/ruta/a/proyectos
# PAGOBLI_OPENCODE_WORKSPACE_ROOT=/workspaces
