# Define una clave larga y única para autorizar la conexión de OpenCode.
PAGOBLI_ACCESS_KEY=cambia-esta-clave-por-una-larga-y-unica

# Activa cuentas y crea al primer administrador al iniciar por primera vez.
# Usa al menos 12 caracteres en la contraseña.
PAGOBLI_ADMIN_EMAIL=admin@tuempresa.mx
PAGOBLI_ADMIN_PASSWORD=cambia-esta-contraseña-por-una-larga
PAGOBLI_ADMIN_NAME=Administración

# Opcional: solo para crear proyectos desde una plantilla con compose.provision.yaml.
# PAGOBLI_TEMPLATE_HOST_DIR=/ruta/a/tu/base-laravel
# PAGOBLI_WORKSPACE_HOST_DIR=/ruta/a/proyectos
# PAGOBLI_OPENCODE_WORKSPACE_ROOT=/workspaces

# Opcional: inicia el compose de cada proyecto recién creado y espera sus health checks.
# Requiere montar el socket de Docker con compose.runtime.yaml.
# PAGOBLI_PROJECT_COMPOSE_FILE=compose.yaml
# PAGOBLI_PROJECT_PREVIEW_URL_TEMPLATE=https://{project}.apps.interna
# PAGOBLI_PROJECT_RUNTIME_TIMEOUT=120
# PAGOBLI_DOCKER_GID=999
